# Supabase is optional.
#
# Leave these blank and the app runs entirely in the browser: state, uploads
# and profile pictures live in localStorage, which is how the public demo works.
#
# Fill them in and the same screens read and write real Postgres rows and
# Storage objects. Both values are on the Supabase dashboard under
# Project Settings > API, and both are safe to expose to the browser — row
# level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
